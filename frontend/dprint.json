{
  "typescript": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": "always",
    "quoteStyle": "preferDouble",
    "trailingCommas": "onlyMultiLine",
    "preferSingleLine": false,
    "arrowFunction.useParentheses": "force"
  },
  "json": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false
  },
  "includes": ["src/**/*.{ts,tsx,js,jsx,json,vue}"],
  "excludes": ["node_modules", "dist"]
}

