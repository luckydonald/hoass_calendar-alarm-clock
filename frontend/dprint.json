{
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.3.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.19.0.wasm"
  ],
  "typescript": {
    "lineWidth": 9999,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": "always",
    "quoteStyle": "preferDouble",
    "trailingCommas": "onlyMultiLine",
    "preferSingleLine": false,
    "arrowFunction.useParentheses": "force",
    "arguments.preferSingleLine": false,
    "parameters.preferSingleLine": false,
    "arrayExpression.preferSingleLine": false,
    "objectExpression.preferSingleLine": false,
    "importDeclaration.preferSingleLine": false,
    "exportDeclaration.preferSingleLine": false,
    "binaryExpression.preferSingleLine": false,
    "memberExpression.preferSingleLine": false,
    "typeLiteral.preferSingleLine": false,
    "tupleType.preferSingleLine": false
  },
  "json": {
    "lineWidth": 9999,
    "indentWidth": 2,
    "useTabs": false,
    "array.preferSingleLine": false,
    "object.preferSingleLine": false
  },
  "markup_fmt": {
    "lineWidth": 9999,
    "indentWidth": 2,
    "closingBracketSameLine": true,
    "vBindStyle": "short",
    "vOnStyle": "short",
    "preferAttrsSingleLine": false
  },
  "includes": ["src/**/*.{ts,tsx,js,jsx,json,vue,html}"],
  "excludes": ["node_modules", "dist"]
}

